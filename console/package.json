{
  "name": "yts-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YT-Showrunner console: local Hono + React/Vite app for conversational season drafting.",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
